APP_ENV=development
FLASK_DEBUG=false
SECRET_KEY=change-me-before-production
APP_BASE_URL=http://127.0.0.1:5000
DATABASE_URL=
DATABASE_PATH=instance/scrapperlanas.sqlite3
CRON_SECRET=change-me-cron-secret
AUTOMATION_MODE=manual
AUTOMATION_POLL_SECONDS=300
AUTOMATION_RUN_ON_STARTUP=true
SCRAPPERLANAS_BASE_URL=http://web:8000
N8N_PUBLIC_URL=http://localhost:5678
N8N_IMPORT_WEBHOOK_PATH=scrapperlanas/import
N8N_SCHEDULER_INTERVAL_MINUTES=15
N8N_BOOTSTRAP_FORCE=false
AI_PROVIDER=heuristic
AI_API_KEY=
AI_MODEL=
AI_EMBED_PROVIDER=
AI_EMBED_MODEL=
AI_BASE_URL=
AI_TEMPERATURE=0.15
AI_MAX_OUTPUT_TOKENS=900
AI_MAX_ENRICHMENTS_PER_RUN=24
AI_MIN_SCORE_FOR_REMOTE_ENRICHMENT=38
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
OLLAMA_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_REQUEST_TIMEOUT_SECONDS=4
OLLAMA_MODEL_PREFERENCES=mistral:latest,qwen2.5-coder:7b,llama3.1:8b
OLLAMA_TEMPERATURE=0.15
OLLAMA_NUM_CTX=8192
REQUEST_TIMEOUT_SECONDS=45
INGEST_USER_AGENT=Scrapperlanas/0.1 (+https://localhost)
CSRF_ENABLED=true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_MINUTES=480
MAX_CONTENT_LENGTH_BYTES=2097152
TRUST_PROXY=false
HOST=127.0.0.1
PORT=5000
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-n8n
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key
