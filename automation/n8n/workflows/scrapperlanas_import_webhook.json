        "jsCode": "const incoming = $json.body ?? $json;\n\nif (Array.isArray(incoming)) {\n  return [{\n    json: {\n      source_key: 'email_alerts',\n      source_label: 'Alertas por Correo',\n      items: incoming,\n    },\n  }];\n}\n\nif (!incoming || typeof incoming !== 'object') {\n  throw new Error('Expected a JSON object or array body.');\n}\n\nif (Array.isArray(incoming.items)) {\n  return [{ json: incoming }];\n}\n\nif (incoming.items && typeof incoming.items === 'object') {\n  return [{ json: { ...incoming, items: [incoming.items] } }];\n}\n\nreturn [{\n  json: {\n    source_key: incoming.source_key ?? 'email_alerts',\n    source_label: incoming.source_label ?? 'Alertas por Correo',\n    items: [incoming],\n  },\n}];"
